# ===================================================================
#  media-suite configuration
# ===================================================================
#  install.sh copies this to .env and fills it in. Values marked
#  [auto] are detected from the host — leave them and they will be
#  replaced. Anything you set by hand always wins over detection.
#
#  .env is gitignored. It holds generated secrets. Keep it that way.
# ===================================================================

# ── Project ────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=media-suite

# Which components to run.
#   plex | jellyfin  — pick exactly one media server
#   monitoring       — Uptime Kuma (~100 MB RAM, recommended)
# Switching media server later: change this line, run ./scripts/update.sh
COMPOSE_PROFILES=plex,monitoring

# ── Host identity ──────────────────────────── [auto] ──────────────
PUID=1000
PGID=1000
TZ=Australia/Perth
UMASK=002

# ── Network ────────────────────────────────── [auto] ──────────────
# Used as the TLS certificate common name.
DOMAIN_NAME=media.home.arpa
# The address clients reach this box on.
SERVER_IP=192.168.1.2
# Treated as trusted by the media server for local direct play.
LAN_NETWORK=192.168.1.0/24

# ── Storage ────────────────────────────────────────────────────────
# DOCKERCONFDIR holds application databases (SQLite). It MUST live on
# block storage — iSCSI or a local disk. NEVER NFS: file locking over
# NFS is not reliable enough for concurrent writes and will corrupt
# these databases. See docs/architecture.md.
DOCKERCONFDIR=/mnt/docker/appdata

# Bulk media and downloads. NFS is fine here — large files, one
# writer, no locking requirements.
DOCKERSTORAGEDIR=/mnt/data

# Traefik runtime state: certificates, dynamic config, access logs.
TRAEFIK_DIR=/mnt/docker/traefik

# ── Container logging ──────────────────────────────────────────────
DOCKERLOGGING_MAXFILE=10
DOCKERLOGGING_MAXSIZE=200k

# ── Image tags ─────────────────────────────────────────────────────
# Pinned deliberately: no :latest, so an install is reproducible and a
# bad release can be rolled back by editing a line here and re-running
# ./scripts/update.sh. There is no Watchtower; updates are a decision.
TRAEFIK_TAG=v3.7
RADARR_TAG=release
SONARR_TAG=release
LIDARR_TAG=release
PROWLARR_TAG=release
QBITTORRENT_TAG=release
HOMARR_TAG=v1.32.0
PLEX_TAG=release
JELLYFIN_TAG=release
UPTIME_KUMA_TAG=2
PORTAINER_TAG=lts

# ── Secrets ────────────────── generated by install.sh ─────────────
# Left blank here on purpose. install.sh writes a value directly into
# .env without ever printing it. Generate manually with:
#   openssl rand -hex 32
SECRET_ENCRYPTION_KEY=

# ── Plex ──────────────────────────── profile: plex ────────────────
# Minted at https://plex.tv/claim — expires 4 minutes after issue.
# Only needed for the first start; the server is linked from then on.
PLEX_CLAIM_TOKEN=
# Helps local clients discover the server in bridge networking.
PLEX_ADVERTISE_URL=http://192.168.1.2:32400
# Requires an active Plex Pass subscription.
PLEX_BETA_INSTALL=false

# ── Jellyfin ──────────────────── profile: jellyfin ────────────────
JELLYFIN_PUBLISHED_SERVER_URL=http://192.168.1.2:8096

# ── TLS certificate subject ────────────────────────────────────────
# Used only when install.sh generates the self-signed certificate.
CERT_VALIDITY_DAYS=7300
CERT_COUNTRY=AU
CERT_STATE=Western Australia
CERT_LOCALITY=Perth
CERT_ORG=HomeLab
