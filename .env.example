# ===================================================================
#  media-suite configuration
# ===================================================================
#  install.sh copies this to .env and fills it in.
#
#  The [auto] fields are left BLANK here on purpose: install.sh detects
#  them from the host on first run. Do not put example values in them —
#  a non-empty value is treated as a deliberate choice and is never
#  overwritten, which is exactly how a placeholder ends up in a live
#  install. On a re-run, anything already set always wins.
#
#  .env is gitignored. It holds generated secrets. Keep it that way.
# ===================================================================

# ── Project ────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=media-suite

# Which components to run.
#   plex | jellyfin  — pick exactly one media server
# Switching media server later: change this line, run ./scripts/update.sh
COMPOSE_PROFILES=plex

# ── Host identity ──────────────────────────── [auto] ──────────────
PUID=
PGID=
TZ=
UMASK=002

# ── Network ────────────────────────────────── [auto] ──────────────
# Used as the TLS certificate common name.
DOMAIN_NAME=
# The address clients reach this box on.
SERVER_IP=
# Treated as trusted by the media server for local direct play.
LAN_NETWORK=

# ── Storage ────────────────────────────────────────────────────────
# DOCKERCONFDIR holds application databases (SQLite). It MUST live on
# block storage — iSCSI or a local disk. NEVER NFS: file locking over
# NFS is not reliable enough for concurrent writes and will corrupt
# these databases. See docs/architecture.md.
DOCKERCONFDIR=/mnt/docker/appdata

# Bulk media and downloads. NFS is fine here — large files, one
# writer, no locking requirements.
DOCKERSTORAGEDIR=/mnt/data

# Traefik runtime state: certificates, dynamic config, access logs.
TRAEFIK_DIR=/mnt/docker/traefik

# ── Container logging ──────────────────────────────────────────────
DOCKERLOGGING_MAXFILE=10
DOCKERLOGGING_MAXSIZE=200k

# ── Image tags ─────────────────────────────────────────────────────
# Pinned deliberately: no :latest, so an install is reproducible and a
# bad release can be rolled back by editing a line here and re-running
# ./scripts/update.sh. There is no Watchtower; updates are a decision.
TRAEFIK_TAG=v3.7
RADARR_TAG=release
SONARR_TAG=release
LIDARR_TAG=release
PROWLARR_TAG=release
QBITTORRENT_TAG=release
HOMARR_TAG=v1.77.2
PLEX_TAG=release
JELLYFIN_TAG=release
TINYAUTH_TAG=v5.2.0
PORTAINER_TAG=lts
DOCKER_PROXY_TAG=0.3
BYPARR_TAG=v3.0.4

# ── Secrets ────────────────── generated by install.sh ─────────────
# Left blank here on purpose. install.sh writes a value directly into
# .env without ever printing it. Generate manually with:
#   openssl rand -hex 32
SECRET_ENCRYPTION_KEY=

# ── Plex ──────────────────────────── profile: plex ────────────────
# Minted at https://plex.tv/claim — expires 4 minutes after issue.
# Only needed for the first start; the server is linked from then on.
PLEX_CLAIM_TOKEN=
# Helps local clients discover the server in bridge networking.
PLEX_ADVERTISE_URL=
# Requires an active Plex Pass subscription.
PLEX_BETA_INSTALL=false

# ── Single sign-on ──────────────────── profile: sso ───────────────
# Where the login page lives. Built from DOMAIN_NAME at install —
# NOT from SERVER_IP: Tinyauth v5 refuses IP addresses outright
# ("ip addresses not allowed"), refuses single-label names, and
# refuses public-suffix domains such as anything under home.arpa.
# It must be a dotted name your clients can resolve to this box.
# <hostname>.local is usually easiest: mDNS answers it with no DNS
# server involved. See docs/authentication.md.
# Credentials are NOT here: tinyauth reads them from files under
# ${DOCKERCONFDIR}/tinyauth, because a bcrypt hash is full of $ that
# Compose would interpolate, and secrets in the environment are
# visible in `docker inspect`.
TINYAUTH_APP_URL=

# The network Traefik reaches Tinyauth over. Detected at install.
TINYAUTH_TRUSTED_PROXIES=

# ── Jellyfin ──────────────────── profile: jellyfin ────────────────
JELLYFIN_PUBLISHED_SERVER_URL=

# ── SMB file share ─────────────────── flag: --smb ──────────────────
# Shares DOCKERSTORAGEDIR over SMB, native on the host (not a
# container — see docs/file-sharing.md for why). Off unless installed
# with --smb. Auth follows AUTH_MODE: guest read-write under
# --auth=none, or the same login as Tinyauth's "admin" account under
# --auth=sso — never a separate credential.
SMB_SHARE=false

# ── TLS certificate subject ────────────────────────────────────────
# Used only when install.sh generates the self-signed certificate.
CERT_VALIDITY_DAYS=7300
CERT_COUNTRY=AU
CERT_STATE=Western Australia
CERT_LOCALITY=Perth
CERT_ORG=HomeLab
